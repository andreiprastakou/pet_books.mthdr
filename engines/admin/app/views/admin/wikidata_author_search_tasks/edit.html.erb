<%= turbo_frame_tag "task_apply_form" do %>
  <div class="card mt-2">
    <div class="card-header">Wikidata author search results</div>
    <div class="card-body">
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if flash[:error].present? %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= flash[:error] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <% data = @task.fetched_data_normalized %>
      <% if data.blank? %>
        <p class="text-muted mb-0">No search results returned.</p>
      <% else %>
        <% author_wikidata_ids = @author.external_identities.wikidata.filter_map(&:external_id).to_set %>
        <table class="table table-bordered align-top mb-0 b-task-fetch-results">
          <tbody>
            <% data.each do |result| %>
              <% result_data = result.is_a?(Hash) ? result : {} %>
              <% entity_id = result_data['external_id'] %>
              <% qid = Admin::ExternalLinkBuilders::Wikidata.normalize_id(entity_id) %>
              <% entity_url = qid && Admin::ExternalLinkBuilders::Wikidata.call(qid) %>
              <% already_added = qid.present? && author_wikidata_ids.include?(qid) %>
              <tr>
                <td class="w-50">
                  <pre class="mb-0 small b-task-fetch-data"><%= JSON.pretty_generate(result) %></pre>
                </td>
                <td class="text-center">
                  <% if qid.present? %>
                    <%= form_with url: add_author_identity_admin_wikidata_author_search_task_path(@task),
                      method: :post,
                      class: "d-flex align-items-center justify-content-center gap-2" do %>
                      <%= hidden_field_tag :entity_id, qid %>
                      <% if entity_url %>
                        <%= external_link_to qid, entity_url %>
                      <% else %>
                        <%= qid %>
                      <% end %>
                      <%= submit_tag "add to the author", class: "btn btn-sm btn-outline-primary",
                        disabled: already_added %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
<% end %>
