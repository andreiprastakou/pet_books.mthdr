<% default_cover = design.cover_image == 'default' %>
<% apply_palette = default_cover && local_assigns[:palette_id].present? %>
<div class="b-cover-standard b-standard-cover--small"
  <% if apply_palette %>style="<%= cover_background_style(palette_id, small: true) %>"<% end %>
  title="<%= "\"#{title}\" by #{author_name}" %>">

  <div class="b-cover-texture"></div>

  <div class="b-standard-cover-small-text-container">
    <div class="b-standard-cover-author"
      data-font="special_elite">
      <%= author_name %>
    </div>

    <div class="b-small-cover-separator"></div>

    <div class="b-standard-cover-title"
      data-font="special_elite">
      <%= title %>
    </div>
  </div>
</div>
