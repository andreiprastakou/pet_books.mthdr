<div class="row b-books-batch-row align-items-center" data-name="book-row">
  <div class="col-1">
    <% if book.persisted? %>
      <%= admin_link_to book.id, admin_book_path(book), target: '_blank' %>
      <%= hidden_field_tag "batch[#{index}][id]", book.id %>
    <% else %>
      <%= text_field_tag "batch[#{index}][id]", nil, class: 'form-control form-control-sm', disabled: true %>
    <% end %>
  </div>
  <!-- Title input -->
  <div class="col-3">
    <%= admin_reversible_input(old_value: book.title_was) do %>
      <%= text_field_tag "batch[#{index}][title]", book.title,
        class: 'form-control form-control-sm',
        data: { name: "title", input_changes_target: "input" } %>
    <% end %>
  </div>
  <!-- Literary form input -->
  <div class="col-1">
    <%= admin_reversible_input(old_value: book.new_record? ? nil : book.literary_form_was) do %>
      <%= admin_literary_form_select_tag "batch[#{index}][literary_form]", book.literary_form,
        class: 'form-select form-select-sm', data: { input_changes_target: "input" } %>
    <% end %>
    <%= admin_literary_form_warning(book.literary_form, (book.literary_form_in_database unless book.new_record?)) %>
  </div>
  <!-- Author input -->
  <div class="col-2" data-controller="association-input">
    <% entries = authors_to_badges_entries(book.authors) %>
    <% ensured_entries = authors_to_badges_entries(
         Array(local_assigns[:ensure_authors]).reject { |item| book.authors.any? { |existing| existing.id == item.id } }
       ) %>
    <%= render "admin/books/form/association_badges_input_mini",
      name: "batch[#{index}][author_ids][]",
      autocomplete_url: admin_api_authors_search_path(format: :json),
      old_values: entries,
      values: entries + ensured_entries %>
  </div>
  <!-- Series input -->
  <% series_column_class = local_assigns[:membership_column].to_s == 'public_list_role' ? 'col-1' : 'col-2' %>
  <div class="<%= series_column_class %>" data-controller="association-input">
    <% entries = series_to_badges_entries(book.series) %>
    <% ensured_entries = series_to_badges_entries(
         Array(local_assigns[:ensure_series]).reject { |item| book.series.any? { |existing| existing.id == item.id } }
       ) %>
    <% preselected_entries = series_to_badges_entries(Array(book.preselected_series)) %>
    <%= render "admin/books/form/association_badges_input_mini",
      name: "batch[#{index}][series_ids][]",
      autocomplete_url: admin_api_series_search_path(format: :json),
      old_values: entries,
      values: entries + ensured_entries + preselected_entries %>
  </div>
  <!-- Year input -->
  <div class="col-1">
    <%= admin_reversible_input(old_value: book.year_published_was) do %>
      <%= text_field_tag "batch[#{index}][year_published]", book.year_published,
        class: 'form-control form-control-sm', data: { input_changes_target: "input" } %>
    <% end %>
  </div>
  <!-- Wiki input -->
  <div class="col-1">
    <div class="b-external-link-input" data-controller="external-link-preview">
      <%= admin_reversible_link_input(old_value: book.wiki_url) do %>
        <%= text_field_tag "batch[#{index}][wiki_url]", book.wiki_url,
          class: 'form-control form-control-sm',
          data: { external_link_preview_target: "input",
            action: "input->external-link-preview#syncUrl",
            input_changes_target: "input" } %>
      <% end %>
      <%= link_to "🔗", nil, target: "_blank", data: { external_link_preview_target: "link" },
        class: "b-batch-external-link" %>
    </div>
  </div>
  <% if local_assigns[:membership_column].to_s == 'public_list_role' %>
    <%= render 'admin/books/batch_membership_field', index: index, role: local_assigns[:membership_role] %>
  <% end %>
  <!-- Remove book button -->
  <div class="col-1">
    <%= button_tag '-', class: 'btn btn-danger btn-sm', title: 'Skip', data: {
      action: 'click->books-batch-form#removeBook' } %>
  </div>
</div>
