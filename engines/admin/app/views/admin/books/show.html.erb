<% admin_nav_crumbs admin_nav_books_link, admin_nav_book_link(@book) %>

<div class="container mt-4">
  <div class="btn-group" role="group">
    <%= display_link_to "show", book_display_path(@book) %>
    <%= admin_buttonly_link_to "edit", edit_admin_book_path(@book) %>
    <%= button_to "generate info", admin_book_generative_summaries_path(@book), method: :post, class: "btn btn-primary me-1" %>
    <% unless @book.external_identities.open_library.exists? %>
      <%= button_to "search in OpenLibrary", admin_book_open_library_searches_path(@book), method: :post,
        class: "btn btn-primary me-1" %>
    <% end %>
    <% if @book.wiki_url.present? %>
      <%= button_to "sync wiki stats", admin_book_wiki_stats_path(@book), method: :put, class: "btn btn-primary me-1" %>
    <% end %>
    <%= button_to "delete", admin_book_path(@book), method: :delete, class: "btn btn-danger", data: { confirm: "Are you sure?" } %>
    <% if (next_book = @book.next_author_book).present? %>
      <%= admin_buttonly_link_to "next: #{truncate(next_book.title, length: 20, escape: false)} (#{next_book.year_published})",
        admin_book_path(next_book) %>
    <% end %>
    <% if @next_summary_task.present? %>
      <%= admin_buttonly_link_to(
        "next review: #{truncate(@next_summary_task.book.title, length: 20, escape: false)} (#{@next_summary_task.book.year_published})",
        admin_data_fetch_task_path(@next_summary_task)
      ) %>
    <% end %>
  </div>
</div>

<div id="<%= dom_id @book %>" class="container mt-4">
  <div class="row">

    <div class="container col-md-6">
      <div class="bg-light border p-3">
        <h5 class="mb-3">GENERAL</h5>

        <% if @book.title != @book.original_title %>
          <div class="row mb-3">
            <div class="col-md-3 font-weight-bold text-end">Title:</div>
            <div class="col-md-9"><%= @book.title %></div>
          </div>
        <% end %>

        <% if @book.original_title.present? %>
          <div class="row mb-3">
            <div class="col-md-3 font-weight-bold text-end">Original Title:</div>
            <div class="col-md-9"><%= @book.original_title %></div>
          </div>
        <% end %>

        <div class="row mb-3">
          <div class="col-md-3 font-weight-bold text-end">Authors:</div>
          <div class="col-md-9">
            <% @book.authors.each do |author| %>
              <%= admin_link_to author.fullname, admin_author_path(author) %> <%= ',' if author != @book.authors.last %>
            <% end %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-md-3 font-weight-bold text-end">Year Published:</div>
          <div class="col-md-9"><%= @book.year_published %></div>
        </div>

        <div class="row mb-3">
          <div class="col-md-3 font-weight-bold text-end">Form:</div>
          <div class="col-md-9">
            <%= @book.literary_form&.humanize %>
          </div>
        </div>

        <% if @book.genres.present? %>
          <div class="row mb-3">
            <div class="col-md-3 font-weight-bold text-end">Genres:</div>
            <div class="col-md-9">
              <% @book.genres.each do |genre| %>
                <span class="badge bg-secondary mr-1 b-admin-genre-badge-link">
                  <%= link_to genre.genre_name, admin_genre_path(genre.genre_id) %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @book.series.present? %>
          <div class="row mb-3">
            <div class="col-md-3 font-weight-bold text-end">Series:</div>
            <div class="col-md-9">
              <% @book.series.each do |series| %>
                <%= admin_link_to series.name, admin_series_path(series) %> <%= ',' if series != @book.series.last %>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @book.tags.present? %>
          <div class="row mb-3">
            <div class="col-md-3 font-weight-bold text-end">Tags:</div>
            <div class="col-md-9">
              <% @book.tags.each do |tag| %>
                <span class="badge bg-secondary mr-1"><%= tag.name %></span>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @book.book_public_lists.present? %>
          <div class="row mb-3">
            <div class="col-md-3 font-weight-bold text-end">Lists:</div>
            <div class="col-md-9">
              <% @book.book_public_lists.each do |book_public_list| %>
                <%= admin_link_to "#{book_public_list.public_list.year} #{book_public_list.public_list.public_list_type.name} - #{book_public_list.role&.humanize}",
                  admin_public_list_type_public_list_path(book_public_list.public_list.public_list_type, book_public_list.public_list) %>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @book.collections.present? %>
          <div class="row mb-3">
            <div class="col-md-3 font-weight-bold text-end">Collections:</div>
            <div class="col-md-9">
              <% @book.collections.each do |collection| %>
                <%= admin_link_to collection.name, admin_collection_path(collection) %>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="row mb-3">
          <div class="col-md-3 font-weight-bold text-end">Created At:</div>
          <div class="col-md-9"><%= admin_timestamp(@book.created_at) %></div>
        </div>

        <div class="row mb-3">
          <div class="col-md-3 font-weight-bold text-end">Updated At:</div>
          <div class="col-md-9"><%= admin_timestamp(@book.updated_at) %></div>
        </div>

        <div class="row mb-3">
          <div class="col-md-3 font-weight-bold text-end">Data Filled:</div>
          <div class="col-md-9"><%= @book.data_filled? ? 'Yes' : 'No' %></div>
        </div>
      </div>

      <div class="bg-light border p-3 mt-3">
        <h5 class="mb-3">LINKS</h5>

        <% if @book.wiki_url.present? %>
          <div class="row mb-3">
            <div class="col-md-3 font-weight-bold text-end">Wiki:</div>
            <div class="col-md-9"><%= admin_link_to_wiki_with_stats(@book) %></div>
          </div>
        <% end %>

        <% if @book.external_links.present? %>
          <div class="row mb-3">
            <div class="col-md-3 font-weight-bold text-end">Links:</div>
            <div class="col-md-9">
              <% @book.external_links.each do |external_link| %>
                <%= external_link_to external_link.external_resource, external_link.url %>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="row mb-3">
          <div class="col-md-3 font-weight-bold text-end">External identities:</div>
          <div class="col-md-9">
            <% @book.external_identities.each do |external_identity| %>
              <% identity_label = external_identity.external_id.presence || '—' %>
              <% identity_url = if external_identity.open_library?
                                  ExternalLinks::OpenLibrary::Work.call(external_identity.external_id)
                                elsif external_identity.wikidata?
                                  ExternalLinks::Wikidata.call(external_identity.external_id)
                                end
                 identity_url ||= external_identity.external_link&.url %>
              <div>
                <%= external_identity.external_resource.to_s.titleize %>:
                <% if identity_url.present? %>
                  <%= external_link_to identity_label, identity_url %>
                <% else %>
                  <%= identity_label %>
                <% end %>
                <%= admin_link_to "edit", edit_admin_book_external_identity_path(@book, external_identity) %>
                <%= admin_link_to "delete", admin_book_external_identity_path(@book, external_identity),
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
                <% if external_identity.open_library? %>
                  <%= admin_link_to "fetch data",
                    admin_book_external_identity_open_library_fetches_path(@book, external_identity),
                    data: { turbo_method: :post } %>
                <% elsif external_identity.wikidata? %>
                  <%= admin_link_to "fetch data",
                    admin_book_external_identity_wikidata_fetches_path(@book, external_identity),
                    data: { turbo_method: :post } %>
                <% end %>
              </div>
            <% end %>
            <%= admin_buttonly_link_to "Add", new_admin_book_external_identity_path(@book) %>
          </div>
        </div>
      </div>

      <div class="bg-light border p-3 mt-3">
        <h5 class="mb-3">HISTORY</h5>
        <% if @history_tasks.present? %>
          <ul class="list-unstyled mb-0">
            <% @history_tasks.each do |task| %>
              <li class="mb-2">
                <%= link_to admin_data_fetch_task_path(task) do %>
                  <%= task.type %>
                  updated <%= admin_timestamp(task.updated_at) %>
                  (<%= task.status.humanize %>)
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-muted mb-0">No tasks yet.</p>
        <% end %>
      </div>
    </div>

    <div class="container col-md-6">
      <div class="bg-light border p-3">
        <h5 class="mb-3">COVER</h5>
        <%= render "admin/books/standard_cover", book: @book %>
      </div>

      <% if @book.summary.present? %>
        <div class="bg-light border p-3 mt-3">
          <h5 class="mb-3">SUMMARY</h5>
          <div class="row mt-3 mb-0">
            <div class="col-md-3 font-weight-bold text-end">Summary:</div>
            <div class="col-md-9 b-book-summary">
              <%= simple_format(@book.summary) %>
              <% if @book.summary_src.present? %>
                <span class="b-book-summary-src">
                  (SRC: <%= @book.summary_src %>)
                </span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
