<% default_cover = design.cover_image == 'default' %>
<% cover_format = local_assigns.fetch(:format, Book::FORMAT_NORMAL) %>
<% collection_cover = cover_format == Book::FORMAT_COLLECTION %>
<% apply_palette = local_assigns[:palette_id].present? && (default_cover || collection_cover) %>
<div class="b-cover-standard b-standard-cover--<%= cover_format %>"
  data-cover-image="<%= collection_cover ? 'default' : design.cover_image %>"
  <% if apply_palette %>style="<%= cover_background_style(palette_id, cover_format) %>"<% end %>
  title="<%= "\"#{title}\" by #{author_name}" %>">

  <div class="b-cover-texture<%= ' b-cover-texture--on-image' unless default_cover || collection_cover %>"></div>

  <div class="b-standard-cover-title"
    data-text-color="<%= design.title_color %>"
    data-font="<%= design.title_font %>">
    <%= title %>
  </div>

  <span class="b-standard-cover-author align-bottom"
    data-text-color="<%= design.author_name_color %>"
    data-font="<%= design.author_name_font %>">
    <%= author_name %>
  </span>
</div>
