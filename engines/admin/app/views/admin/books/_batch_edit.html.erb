<% initial_series = Array(local_assigns[:initial_series]) %>
<% initial_series_entries = series_to_badges_entries(initial_series) %>
<% ensure_authors = Array(local_assigns[:ensure_authors]) %>
<% membership_column = local_assigns[:membership_column].to_s.presence %>
<% show_list_role = membership_column == 'public_list_role' %>
<% series_column_class = show_list_role ? 'col-1' : 'col-2' %>
<% membership_roles = local_assigns.fetch(:membership_roles, {}) %>
<% row_url_params = {} %>
<% row_url_params[:ensure_series_id] = initial_series.first.id if initial_series.one? %>
<% row_url_params[:ensure_author_id] = ensure_authors.first.id if ensure_authors.one? %>
<% row_url_params[:membership_column] = membership_column if show_list_role %>
<div class="b-books-batch-form container mt-4" data-controller="books-batch-form"
  data-books-batch-form-batch-row-url-value="<%= admin_books_batch_row_path('BOOK_ID', row_url_params) %>">
  <% target = local_assigns.fetch(:target) %>
  <% method = local_assigns.fetch(:method, :put) %>
  <% initial_author_entries = authors_to_badges_entries(Array(local_assigns[:initial_authors])) %>
  <% initial_literary_form = local_assigns[:initial_literary_form] %>
  <% initial_year_published = local_assigns[:initial_year_published] %>
  <%= form_tag target, method: method do %>
    <div data-books-batch-form-target="notices"></div>

    <div class="row b-books-batch-row b-books-batch-header fw-bold text-muted">
      <div class="col-1">ID</div>
      <div class="col-2">Title</div>
      <div class="col-1">Original</div>
      <div class="col-1">Form</div>
      <div class="col-2">Author</div>
      <div class="<%= series_column_class %>">Series</div>
      <div class="col-1">Year</div>
      <div class="col-1">Wiki</div>
      <% if show_list_role %>
        <div class="col-1 b-books-batch-membership" title="Role on this list">Role</div>
      <% end %>
      <div class="col-1"></div>
    </div>

    <div data-books-batch-form-target="booksList">
      <% books.sort_by { |b| b.year_published.to_i }.each_with_index do |book, index| %>
        <%= render 'admin/books/batch_row',
          book: book,
          index: index,
          membership_column: (membership_column if show_list_role),
          membership_role: membership_roles[book] %>
      <% end %>
    </div>

    <template data-books-batch-form-target="bookTemplate">
      <% index = "ENTRY_INDEX" %>
      <div class="row b-books-batch-row align-items-center" data-name="book-row">
        <div class="col-1">
          <%= text_field_tag "batch[#{index}][id]", nil, class: 'form-control form-control-sm', disabled: true %>
        </div>
        <div class="col-2">
          <div class="b-autocomplete-container b-book-title-autocomplete" data-controller="autocomplete"
            data-autocomplete-url-value="<%= admin_api_books_search_path(format: :json) %>"
            data-action="autocomplete:selected->books-batch-form#onExistingBookSelected">
            <%= text_field_tag "batch[#{index}][title]", nil,
              class: 'form-control form-control-sm', autocomplete: 'off',
              data: {
                name: "title",
                autocomplete_target: "input",
                action: "input->autocomplete#search blur->autocomplete#handleBlur focus->autocomplete#handleFocus"
              } %>
            <div class="list-group b-autocomplete-results" data-autocomplete-target="results"></div>
          </div>
        </div>
        <div class="col-1">
          <%= text_field_tag "batch[#{index}][original_title]", nil, class: 'form-control form-control-sm' %>
        </div>
        <div class="col-1">
          <%= text_field_tag "batch[#{index}][literary_form]", initial_literary_form, class: 'form-control form-control-sm' %>
        </div>
        <!-- Author input -->
        <div class="col-2" data-controller="association-input">
          <%= render "admin/books/form/association_badges_input_mini",
            name: "batch[#{index}][author_ids][]",
            autocomplete_url: admin_api_authors_search_path(format: :json),
            old_values: [],
            values: initial_author_entries %>
        </div>
        <!-- Series input -->
        <div class="<%= series_column_class %>" data-controller="association-input">
          <%= render "admin/books/form/association_badges_input_mini",
            name: "batch[#{index}][series_ids][]",
            autocomplete_url: admin_api_series_search_path(format: :json),
            old_values: [],
            values: initial_series_entries %>
        </div>
        <!-- Year input -->
        <div class="col-1">
          <%= text_field_tag "batch[#{index}][year_published]", initial_year_published,
            class: 'form-control form-control-sm' %>
        </div>
        <!-- Wiki input -->
        <div class="col-1">
          <div class="b-external-link-input" data-controller="external-link-preview">
            <%= text_field_tag "batch[#{index}][wiki_url]", nil, class: 'form-control form-control-sm',
              data: { external_link_preview_target: "input", action: "input->external-link-preview#syncUrl" } %>
            <%= link_to "L", nil, target: "_blank", data: { external_link_preview_target: "link" } %>
          </div>
        </div>
        <% if show_list_role %>
          <%= render 'admin/books/batch_membership_field', index: index, role: nil %>
        <% end %>
        <!-- Remove book button -->
        <div class="col-1">
          <%= button_tag '-', class: 'btn btn-danger btn-sm', title: 'Skip',
            data: { action: 'click->books-batch-form#removeBook' } %>
        </div>
      </div>
    </template>

    <div class="row mt-4">
      <!-- Add book button -->
      <div class="col-12 mb-3">
        <%= button_tag '+ book', class: 'btn btn-success btn-lg',
          data: { action: 'click->books-batch-form#onClickAddBook' } %>
      </div>

      <!-- Submit button -->
      <div class="col-12">
        <%= submit_tag 'Update all', class: 'btn btn-primary btn-lg' %>
      </div>
    </div>
  <% end %>

  <% if local_assigns[:actions].present? %>
    <div class="row mt-3">
      <% local_assigns[:actions].each do |action_element| %>
        <div class="me-2 d-inline-block">
          <%= action_element %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
