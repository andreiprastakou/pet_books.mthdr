<% admin_nav_crumbs admin_nav_books_link, admin_nav_book_link(@book), "Collection Batch Edit" %>

<%= render 'admin/common/parental_references', record: @book %>

<div class="card mt-2">
  <div class="card-header">
    Books to update:
  </div>

  <div class="card-body">
    <% new_work_authors = @book.authors.size > 2 ? [] : @book.authors %>
    <%= render 'admin/books/batch_edit',
      books: @books,
      target: admin_book_collection_batch_path(@book),
      initial_authors: new_work_authors,
      autocomplete_author_ids: @book.authors.map(&:id),
      initial_literary_form: 'short' %>
  </div>
</div>
