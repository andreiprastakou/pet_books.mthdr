<% input_class = local_assigns[:input_class] %>
<% input_hidden = local_assigns[:input_hidden] %>
<% input_target = local_assigns[:input_target] %>
<% autocomplete_target = local_assigns[:autocomplete_target] %>

<div class="col-md-6" data-association-input-target="badges" data-values="<%= values.to_json %>"
  data-old-values="<%= old_values.to_json %>">
  <template data-association-input-target="badgeTemplate">
    <span class="badge bg-secondary mr-1 b-badge" data-name="badge">
      <%= tag.span class: "b-badge-name", data: { name: "label" } %>
      <%= hidden_field_tag name, nil, data: { name: "badgeValueInput", association_input_target: "badgeValueInput" } %>
      <span class="b-badge-delete-button" data-action="click->association-input#onClickDeleteBadge">
        -
      </span>
      <span class="b-badge-restore-button" data-action="click->association-input#onClickRestoreBadge">
        +
      </span>
    </span>
  </template>
</div>

<div class="col-md-4<%= " #{input_class}" if input_class.present? %>"
  <% if input_hidden %>hidden<% end %>
  <% if input_target.present? %>data-book-form-target="<%= input_target %>"<% end %>>
  <div class="col-12 b-autocomplete-container" data-controller="autocomplete"
    data-autocomplete-url-value="<%= autocomplete_url %>"
    <% if local_assigns.key?(:author_ids) %>
    data-autocomplete-author-ids-value="<%= Array(local_assigns[:author_ids]).to_json %>"
    <% end %>
    <% if autocomplete_target.present? %>
    data-book-form-target="<%= autocomplete_target %>"
    <% end %>
    data-action="autocomplete:selected->association-input#onEntrySelected">
    <%= text_field_tag nil, nil,
      class: 'form-control', autocomplete: 'off',
      placeholder: 'search or create...',
      data: {
        autocomplete_target: "input",
        association_input_target: "newNameInput",
        action: "input->association-input#updateAddButton input->autocomplete#search blur->autocomplete#handleBlur focus->autocomplete#handleFocus"
      } %>
    <div class="list-group b-autocomplete-results" data-autocomplete-target="results"></div>
  </div>
</div>
<div class="col-md-2">
  <%= button_tag "Add", class: "btn btn-success", disabled: true,
    data: { action: "click->association-input#onAddClicked", association_input_target: "addButton" } %>
</div>
