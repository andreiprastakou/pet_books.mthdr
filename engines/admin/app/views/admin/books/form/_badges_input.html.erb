<div class="col-md-6" data-badges-input-target="badges" data-values="<%= current_values.to_json %>"
  data-old-value="<%= old_values.to_json %>">
  <template data-badges-input-target="badgeTemplate">
    <span class="badge bg-secondary mr-1 b-badge" data-name="badge">
      <span class="b-badge-name" data-name="name"></span>
      <%= hidden_field_tag name, nil, data: { name: "badgeNameInput", badges_input_target: "badgeNameInput" } %>
      <span class="b-badge-delete-button" data-action="click->badges-input#deleteBadge">
        -
      </span>
      <span class="b-badge-restore-button" data-action="click->badges-input#restoreBadge">
        +
      </span>
    </span>
  </template>
</div>
<div class="col-md-4">
  <% if local_assigns[:autocomplete_url].present? %>
    <div class="b-autocomplete-container" data-controller="autocomplete"
      data-autocomplete-url-value="<%= autocomplete_url %>"
      data-action="autocomplete:selected->badges-input#onEntrySelected">
      <%= text_field nil, nil, class: "form-control", placeholder: 'search or create...', autocomplete: 'off',
        data: {
          badges_input_target: "badgeNewNameInput",
          autocomplete_target: "input",
          action: "input->badges-input#updateBadgeAddButton input->autocomplete#search blur->autocomplete#handleBlur focus->autocomplete#handleFocus"
        } %>
      <div class="list-group b-autocomplete-results" data-autocomplete-target="results"></div>
    </div>
  <% else %>
    <%= text_field nil, nil, class: "form-control", placeholder: 'enter...',
      data: { action: "input->badges-input#updateBadgeAddButton", badges_input_target: "badgeNewNameInput" } %>
  <% end %>
</div>
<div class="col-md-2">
  <%= button_tag "new", class: "btn btn-success",
    data: { action: "click->badges-input#onAddClicked", badges_input_target: "addButton" } %>
</div>
