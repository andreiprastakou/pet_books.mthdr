<% author_ol_links = @author.external_identities.open_library.filter_map { |identity|
  url = Admin::ExternalLinkBuilders::OpenLibrary::Author.call(identity.external_id)
  url && external_link_to(identity.external_id, url)
} %>

<%= turbo_frame_tag "task_apply_form" do %>
  <div class="card mt-2">
    <div class="card-header">
      Open Library author fetch results
    </div>

    <div class="card-body">
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if flash[:error].present? %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= flash[:error] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <div class="mb-4">
        <div class="row mb-2">
          <div class="col-md-3 font-weight-bold text-end">Author:</div>
          <div class="col-md-9">
            <%= @author.fullname %><% if author_ol_links.any? %> (<%= safe_join(author_ol_links, ', ') %>)<% end %>
          </div>
        </div>

        <div class="row mb-2">
          <div class="col-md-3 font-weight-bold text-end">Birth year:</div>
          <div class="col-md-9"><%= @author.birth_year.presence || content_tag(:span, 'None', class: 'text-muted') %></div>
        </div>

        <div class="row mb-2">
          <div class="col-md-3 font-weight-bold text-end">Death year:</div>
          <div class="col-md-9"><%= @author.death_year.presence || content_tag(:span, 'None', class: 'text-muted') %></div>
        </div>

        <div class="row mb-2">
          <div class="col-md-3 font-weight-bold text-end">Current description:</div>
          <div class="col-md-9">
            <% if @task_description&.text.present? %>
              <%= simple_format(@task_description.text) %>
              <% if @task_description.display_source_label.present? %>
                <span class="text-muted">(SRC: <%= @task_description.display_source_label %>)</span>
              <% end %>
            <% else %>
              <span class="text-muted">None</span>
            <% end %>
          </div>
        </div>
      </div>

      <% if @fetched_data.blank? %>
        <p class="text-muted">No fetch results returned.</p>
      <% else %>
        <table class="table table-bordered align-top mb-0 b-task-fetch-results">
          <tbody>
            <tr>
              <td class="w-50">
                <pre class="mb-0 small b-task-fetch-data"><%= JSON.pretty_generate(@fetched_data) %></pre>
              </td>
              <td class="text-center">
                <% if @birth_year.present? %>
                  <%= form_with url: apply_birth_year_admin_open_library_author_fetch_task_path(@task),
                    method: :post,
                    class: "d-flex align-items-center justify-content-center gap-2 mb-2 flex-wrap" do %>
                    <%= label_tag :birth_year, 'birth year', class: 'mb-0' %>
                    <%= number_field_tag :year, @birth_year, class: 'form-control form-control-sm w-auto',
                      id: 'birth_year', readonly: true %>
                    <% if @author.birth_year.blank? %>
                      <%= submit_tag 'add', class: 'btn btn-sm btn-outline-primary' %>
                    <% elsif @author.birth_year == @birth_year %>
                      <%= submit_tag 'add', class: 'btn btn-sm btn-outline-primary', disabled: true %>
                    <% else %>
                      <%= submit_tag "change from #{@author.birth_year}", class: 'btn btn-sm btn-outline-primary' %>
                    <% end %>
                  <% end %>
                <% end %>

                <% if @death_year.present? %>
                  <%= form_with url: apply_death_year_admin_open_library_author_fetch_task_path(@task),
                    method: :post,
                    class: "d-flex align-items-center justify-content-center gap-2 mb-2 flex-wrap" do %>
                    <%= label_tag :death_year, 'death year', class: 'mb-0' %>
                    <%= number_field_tag :year, @death_year, class: 'form-control form-control-sm w-auto',
                      id: 'death_year', readonly: true %>
                    <% if @author.death_year.blank? %>
                      <%= submit_tag 'add', class: 'btn btn-sm btn-outline-primary' %>
                    <% elsif @author.death_year == @death_year %>
                      <%= submit_tag 'add', class: 'btn btn-sm btn-outline-primary', disabled: true %>
                    <% else %>
                      <%= submit_tag "change from #{@author.death_year}", class: 'btn btn-sm btn-outline-primary' %>
                    <% end %>
                  <% end %>
                <% end %>

                <% if @bio.present? %>
                  <%= form_with url: apply_description_admin_open_library_author_fetch_task_path(@task),
                    method: :post,
                    class: 'mt-3 text-start' do %>
                    <%= label_tag :text, 'Description', class: 'form-label' %>
                    <%= text_area_tag :text, @bio, class: 'form-control mb-2', rows: 6 %>
                    <%= submit_tag 'apply', class: 'btn btn-sm btn-outline-primary' %>
                  <% end %>
                <% end %>

                <% @remote_ids.each do |identifier| %>
                  <% external_resource = identifier['external_resource'] %>
                  <% external_id = identifier['external_id'] %>
                  <% link_builder = Admin::ExternalIdentityIntroductor.link_builder_for(external_resource, Author) %>
                  <% identity_url = link_builder&.call(external_id) %>
                  <% already_added = @author_identity_keys.include?([external_resource, external_id]) %>
                  <%= form_with url: add_identity_admin_open_library_author_fetch_task_path(@task),
                    method: :post,
                    class: "d-flex align-items-center justify-content-center gap-2 mb-2 flex-wrap" do %>
                    <%= hidden_field_tag :external_resource, external_resource %>
                    <%= hidden_field_tag :external_id, external_id %>
                    <span><%= external_resource %></span>
                    <% if identity_url.present? %>
                      <%= external_link_to external_id, identity_url %>
                    <% else %>
                      <%= external_id %>
                    <% end %>
                    <%= submit_tag 'add', class: 'btn btn-sm btn-outline-primary', disabled: already_added %>
                  <% end %>
                <% end %>

                <% @links.each_with_index do |link, index| %>
                  <% external_resource = link['external_resource'] %>
                  <% url = link['url'] %>
                  <% already_added = @author_link_urls.include?(url) %>
                  <%= form_with url: add_link_admin_open_library_author_fetch_task_path(@task),
                    method: :post,
                    class: "d-flex align-items-center justify-content-center gap-2 mb-2 flex-wrap" do %>
                    <%= hidden_field_tag :url, url %>
                    <%= text_field_tag :external_resource, external_resource,
                      class: 'form-control form-control-sm w-auto',
                      id: "external_resource_#{index}" %>
                    <%= external_link_to '🔗', url %>
                    <%= submit_tag 'add', class: 'btn btn-sm btn-outline-primary', disabled: already_added %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
<% end %>
