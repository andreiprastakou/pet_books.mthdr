<% admin_nav_crumbs admin_nav_public_list_types_link,
  admin_nav_public_list_type_link(@public_list_type),
  [admin_nav_public_list_link(@public_list), admin_public_list_type_public_list_path(@public_list_type, @public_list)],
  "Books Batch Edit" %>

<%= render 'admin/common/parental_references', record: @public_list %>

<div class="card mt-2">
  <div class="card-header">
    Books to update:
  </div>

  <div class="card-body">
    <%= render 'admin/books/batch_edit',
      books: @books,
      target: admin_public_list_type_public_list_books_batch_path(@public_list_type, @public_list),
      initial_year_published: @public_list.year - 1,
      membership_column: 'public_list_role',
      membership_roles: @membership_roles %>
  </div>
</div>
