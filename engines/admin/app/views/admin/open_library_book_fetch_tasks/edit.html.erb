<%= turbo_frame_tag "task_apply_form" do %>
  <div class="card mt-2">
    <div class="card-header">
      Open Library fetch results
    </div>

    <div class="card-body">
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if flash[:error].present? %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= flash[:error] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <% if @fetched_data.blank? %>
        <p class="text-muted">No fetch results returned.</p>
      <% else %>
        <table class="table table-bordered align-top mb-0 b-task-fetch-results">
          <tbody>
            <tr>
              <td class="w-50">
                <pre class="mb-0 small b-task-fetch-data"><%= JSON.pretty_generate(@fetched_data) %></pre>
              </td>
              <td class="text-center">
                <% Array(@fetched_data['authors']).each_with_index do |author_entry, index| %>
                  <% author_key = author_entry['external_id'] %>
                  <% author_olid = Admin::ExternalLinkBuilders::OpenLibrary::Author.normalize_id(author_key) %>
                  <% next if author_olid.blank? %>
                  <% author_url = Admin::ExternalLinkBuilders::OpenLibrary::Author.call(author_olid) %>
                  <% existing_identity = @author_identities_by_olid[author_olid] %>
                  <% existing_author = existing_identity&.owner %>
                  <% already_assigned = existing_author.present? %>
                  <% author_on_book = existing_author && @book.author_ids.include?(existing_author.id) %>
                  <% select_authors = @book.authors.to_a %>
                  <% select_authors = (select_authors + [existing_author]).uniq if existing_author && !author_on_book %>
                  <div class="mb-2">
                    <%= form_with url: add_author_identity_admin_open_library_book_fetch_task_path(@task),
                      method: :post,
                      class: 'd-flex align-items-center justify-content-center gap-2 flex-wrap' do %>
                      <%= hidden_field_tag :author_key, author_olid %>
                      <% if author_url %>
                        <%= external_link_to author_olid, author_url %>
                      <% else %>
                        <%= author_olid %>
                      <% end %>
                      <%= select_tag :author_id,
                        options_from_collection_for_select(select_authors, :id, :fullname, existing_author&.id),
                        class: 'form-select form-select-sm w-auto',
                        id: "author_id_#{index}",
                        disabled: already_assigned || select_authors.empty? %>
                      <%= submit_tag 'add to the author', class: 'btn btn-sm btn-outline-primary',
                        disabled: already_assigned || select_authors.empty? %>
                    <% end %>
                    <% if existing_author && !author_on_book %>
                      <div class="text-danger small mt-1">
                        Author "<%= existing_author.fullname %>" is not linked to this book.
                      </div>
                    <% end %>
                  </div>
                <% end %>

                <% Array(@fetched_data['genres']).each_with_index do |genre_entry, index| %>
                  <% genre_key = Admin::Tasks::OpenLibraryBookFetch.normalize_open_library_key(genre_entry['external_id']) %>
                  <% next if genre_key.blank? %>
                  <% genre_url = Admin::Tasks::OpenLibraryBookFetch.open_library_url(genre_key) %>
                  <% existing_identity = @genre_identities_by_olid[genre_key] %>
                  <% existing_genre = existing_identity&.owner %>
                  <% already_assigned = existing_genre.present? %>
                  <% genre_on_book = existing_genre && @book_genres.any? { |genre| genre.id == existing_genre.id } %>
                  <% select_genres = @book_genres.dup %>
                  <% select_genres = (select_genres + [Admin::Genre.cast(existing_genre)]).uniq if existing_genre && !genre_on_book %>
                  <div class="mb-2">
                    <%= form_with url: add_genre_identity_admin_open_library_book_fetch_task_path(@task),
                      method: :post,
                      class: 'd-flex align-items-center justify-content-center gap-2 flex-wrap' do %>
                      <%= hidden_field_tag :genre_key, genre_key %>
                      <% if genre_url %>
                        <%= external_link_to genre_key, genre_url %>
                      <% else %>
                        <%= genre_key %>
                      <% end %>
                      <%= select_tag :genre_id,
                        options_from_collection_for_select(select_genres, :id, :name, existing_genre&.id),
                        class: 'form-select form-select-sm w-auto',
                        id: "genre_id_#{index}",
                        disabled: already_assigned || select_genres.empty? %>
                      <%= submit_tag 'add to the genre', class: 'btn btn-sm btn-outline-primary',
                        disabled: already_assigned || select_genres.empty? %>
                    <% end %>
                    <% if existing_genre && !genre_on_book %>
                      <div class="text-danger small mt-1">
                        Genre "<%= existing_genre.name %>" is not linked to this book.
                      </div>
                    <% end %>
                  </div>
                <% end %>

                <% Array(@fetched_data['series']).each_with_index do |series_entry, index| %>
                  <% series_key = Admin::Tasks::OpenLibraryBookFetch.normalize_open_library_key(series_entry['external_id']) %>
                  <% next if series_key.blank? %>
                  <% series_url = Admin::Tasks::OpenLibraryBookFetch.open_library_url(series_key) %>
                  <% existing_identity = @series_identities_by_olid[series_key] %>
                  <% existing_series = existing_identity&.owner %>
                  <% already_assigned = existing_series.present? %>
                  <% series_on_book = existing_series && @book.series_ids.include?(existing_series.id) %>
                  <% select_series = @book_series.dup %>
                  <% select_series = (select_series + [Admin::Series.cast(existing_series)]).uniq if existing_series && !series_on_book %>
                  <div class="mb-2">
                    <%= form_with url: add_series_identity_admin_open_library_book_fetch_task_path(@task),
                      method: :post,
                      class: 'd-flex align-items-center justify-content-center gap-2 flex-wrap' do %>
                      <%= hidden_field_tag :series_key, series_key %>
                      <% if series_url %>
                        <%= external_link_to series_key, series_url %>
                      <% else %>
                        <%= series_key %>
                      <% end %>
                      <%= select_tag :series_id,
                        options_from_collection_for_select(select_series, :id, :name, existing_series&.id),
                        class: 'form-select form-select-sm w-auto',
                        id: "series_id_#{index}",
                        disabled: already_assigned || select_series.empty? %>
                      <%= submit_tag 'add to the series', class: 'btn btn-sm btn-outline-primary',
                        disabled: already_assigned || select_series.empty? %>
                    <% end %>
                    <% if existing_series && !series_on_book %>
                      <div class="text-danger small mt-1">
                        Series "<%= existing_series.name %>" is not linked to this book.
                      </div>
                    <% end %>
                  </div>
                <% end %>

                <% Array(@fetched_data['identifiers']).each do |identifier| %>
                  <% external_resource = identifier['external_resource'] %>
                  <% external_id = identifier['external_id'] %>
                  <% link_builder = Admin::ExternalIdentityIntroductor.link_builder_for(external_resource, Book) %>
                  <% identity_url = link_builder&.call(external_id) %>
                  <% already_added = @book_identity_keys.include?([external_resource, external_id]) %>
                  <%= form_with url: add_identity_admin_open_library_book_fetch_task_path(@task),
                    method: :post,
                    class: 'd-flex align-items-center justify-content-center gap-2 mb-2 flex-wrap' do %>
                    <%= hidden_field_tag :external_resource, external_resource %>
                    <%= hidden_field_tag :external_id, external_id %>
                    <span><%= external_resource %></span>
                    <% if identity_url.present? %>
                      <%= external_link_to external_id, identity_url %>
                    <% else %>
                      <%= external_id %>
                    <% end %>
                    <%= submit_tag 'add', class: 'btn btn-sm btn-outline-primary', disabled: already_added %>
                  <% end %>
                <% end %>

                <% if @description.present? %>
                  <%= form_with url: apply_summary_admin_open_library_book_fetch_task_path(@task),
                    method: :post,
                    class: 'mt-3 text-start' do %>
                    <%= label_tag :text, 'Description', class: 'col-form-label-sm' %>
                    <%= admin_reversible_input(old_value: @task_description&.text) do %>
                      <%= text_area_tag :text, @description, class: 'form-control mb-2', rows: 6,
                        data: { input_changes_target: 'input' } %>
                    <% end %>
                    <div class="text-end">
                      <% if @task_description&.text.blank? %>
                        <%= submit_tag 'add', class: 'btn btn-sm btn-outline-primary' %>
                      <% else %>
                        <%= submit_tag 'update',
                          class: 'btn btn-sm btn-outline-primary',
                          disabled: @task_description.text == @description,
                          data: { input_changes_submit: true } %>
                      <% end %>
                    </div>
                  <% end %>
                <% end %>

                <% @links.each_with_index do |link, index| %>
                  <% external_resource = link['external_resource'] %>
                  <% url = link['url'] %>
                  <% existing_link = @book_links_by_url[url] %>
                  <%= form_with url: add_link_admin_open_library_book_fetch_task_path(@task),
                    method: :post,
                    class: 'd-flex align-items-start justify-content-center gap-2 mb-2 mt-2 b-task-link-form' do %>
                    <%= hidden_field_tag :url, url %>
                    <%= admin_reversible_input(old_value: existing_link&.external_resource) do %>
                      <%= text_field_tag :external_resource, external_resource,
                        class: 'form-control form-control-sm',
                        id: "external_resource_#{index}",
                        data: { input_changes_target: 'input' } %>
                    <% end %>
                    <%= external_link_icon_to url %>
                    <% if existing_link.nil? %>
                      <%= submit_tag 'add', class: 'btn btn-sm btn-outline-primary' %>
                    <% else %>
                      <%= submit_tag 'update label',
                        class: 'btn btn-sm btn-outline-primary',
                        disabled: existing_link.external_resource == external_resource,
                        data: { input_changes_submit: true } %>
                    <% end %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
<% end %>
