<%= turbo_frame_tag "task_apply_form" do %>
  <div class="card mt-2">
    <div class="card-header">
      Wikipedia fetch results
    </div>

    <div class="card-body">
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if flash[:error].present? %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= flash[:error] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <% if @fetched_data.blank? %>
        <p class="text-muted">No fetch results returned.</p>
      <% else %>
        <table class="table table-bordered align-top mb-0 b-task-fetch-results">
          <tbody>
            <tr>
              <td class="w-50">
                <pre class="mb-0 small b-task-fetch-data"><%= JSON.pretty_generate(@fetched_data) %></pre>
              </td>
              <td class="text-center">
                <% if @description.present? %>
                  <%= form_with url: apply_description_admin_wikipedia_author_fetch_task_path(@task),
                    method: :post,
                    class: 'mt-3 text-start' do %>
                    <%= label_tag :text, 'Description', class: 'col-form-label-sm' %>
                    <%= admin_reversible_input(old_value: @task_description&.text) do %>
                      <%= text_area_tag :text, @description, class: 'form-control mb-2', rows: 6,
                        data: { input_changes_target: 'input' } %>
                    <% end %>
                    <div class="text-end">
                      <% if @task_description&.text.blank? %>
                        <%= submit_tag 'add', class: 'btn btn-sm btn-outline-primary' %>
                      <% else %>
                        <%= submit_tag 'update',
                          class: 'btn btn-sm btn-outline-primary',
                          disabled: @task_description.text == @description,
                          data: { input_changes_submit: true } %>
                      <% end %>
                    </div>
                  <% end %>
                <% end %>
              </td>
            </tr>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
<% end %>
