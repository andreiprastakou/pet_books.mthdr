<% admin_nav_crumbs admin_nav_series_index_link, [admin_nav_series_link(@series), admin_series_path(@series)], "Books Batch Edit" %>

<div class="card">
  <div class="card-header">
    Series:
  </div>

  <div class="card-body">
    <div class="row mb-3">
      <div class="col-md-3 font-weight-bold text-end"><%= @series.name %></div>
      <div class="col-md-9"><%= admin_external_links_list(@series) %></div>
    </div>
  </div>
</div>

<div class="card mt-2">
  <div class="card-header">
    Books to update:
  </div>

  <div class="card-body">
    <%= render 'admin/books/batch_edit',
      books: @books,
      target: admin_series_books_batch_path(@series),
      initial_series: [@series] %>
  </div>
</div>
