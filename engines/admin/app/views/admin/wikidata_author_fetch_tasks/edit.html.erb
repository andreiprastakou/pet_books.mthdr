<%= turbo_frame_tag "task_apply_form" do %>
  <div class="card mt-2">
    <div class="card-header">
      Wikidata fetch results
    </div>

    <div class="card-body">
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if flash[:error].present? %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= flash[:error] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <% if @fetched_data.blank? %>
        <p class="text-muted">No fetch results returned.</p>
      <% else %>
        <table class="table table-bordered align-top mb-0 b-task-fetch-results">
          <tbody>
            <tr>
              <td class="w-50">
                <pre class="mb-0 small b-task-fetch-data"><%= JSON.pretty_generate(@fetched_data) %></pre>
              </td>
              <td class="text-center">
                <% if @birth_year.present? %>
                  <%= form_with url: apply_birth_year_admin_wikidata_author_fetch_task_path(@task),
                    method: :post,
                    class: 'd-flex align-items-start justify-content-center gap-2 mb-2 b-task-year-form' do %>
                    <%= label_tag :birth_year, 'Born in', class: 'col-form-label col-form-label-sm mb-0' %>
                    <%= admin_reversible_input(old_value: @author.birth_year) do %>
                      <%= text_field_tag :year, @birth_year, class: 'form-control form-control-sm',
                        id: 'birth_year', data: { input_changes_target: 'input' } %>
                    <% end %>
                    <% if @author.birth_year.blank? %>
                      <%= submit_tag 'add', class: 'btn btn-sm btn-outline-primary' %>
                    <% else %>
                      <%= submit_tag 'update',
                        class: 'btn btn-sm btn-outline-primary',
                        disabled: @author.birth_year.to_s == @birth_year.to_s,
                        data: { input_changes_submit: true } %>
                    <% end %>
                  <% end %>
                <% end %>

                <% if @death_year.present? %>
                  <%= form_with url: apply_death_year_admin_wikidata_author_fetch_task_path(@task),
                    method: :post,
                    class: 'd-flex align-items-start justify-content-center gap-2 mb-2 b-task-year-form' do %>
                    <%= label_tag :death_year, 'Died in', class: 'col-form-label col-form-label-sm mb-0' %>
                    <%= admin_reversible_input(old_value: @author.death_year) do %>
                      <%= text_field_tag :year, @death_year, class: 'form-control form-control-sm',
                        id: 'death_year', data: { input_changes_target: 'input' } %>
                    <% end %>
                    <% if @author.death_year.blank? %>
                      <%= submit_tag 'add', class: 'btn btn-sm btn-outline-primary' %>
                    <% else %>
                      <%= submit_tag 'update',
                        class: 'btn btn-sm btn-outline-primary',
                        disabled: @author.death_year.to_s == @death_year.to_s,
                        data: { input_changes_submit: true } %>
                    <% end %>
                  <% end %>
                <% end %>

                <% @external_identities.each do |identifier| %>
                  <% external_resource = identifier['external_resource'] %>
                  <% external_id = identifier['external_id'] %>
                  <% link_builder = Admin::ExternalIdentityIntroductor.link_builder_for(external_resource, Author) %>
                  <% identity_url = link_builder&.call(external_id) %>
                  <% already_added = @author_identity_keys.include?([external_resource, external_id]) %>
                  <%= form_with url: add_identity_admin_wikidata_author_fetch_task_path(@task),
                    method: :post,
                    class: 'd-flex align-items-center justify-content-center gap-2 mb-2 flex-wrap' do %>
                    <%= hidden_field_tag :external_resource, external_resource %>
                    <%= hidden_field_tag :external_id, external_id %>
                    <span><%= external_resource %></span>
                    <% if identity_url.present? %>
                      <%= external_link_to external_id, identity_url %>
                    <% else %>
                      <%= external_id %>
                    <% end %>
                    <%= submit_tag 'add', class: 'btn btn-sm btn-outline-primary', disabled: already_added %>
                  <% end %>
                <% end %>

                <% if @wikipedia_sitelinks.any? %>
                  <% selected_wikipedia = @wikipedia_sitelinks.first %>
                  <%= form_with url: add_wikipedia_link_admin_wikidata_author_fetch_task_path(@task),
                    method: :post,
                    class: 'd-flex align-items-center justify-content-center gap-2 mb-2 flex-wrap',
                    data: {
                      controller: 'sitelink-select',
                      sitelink_select_existing_urls_value: @author_link_urls.to_a.to_json
                    } do %>
                    <%= select_tag :url,
                      options_for_select(
                        @wikipedia_sitelinks.map { |link|
                          label = [link['language'], link['title']].compact_blank.join(' — ')
                          [label.presence || link['url'], link['url']]
                        },
                        selected_wikipedia['url']
                      ),
                      class: 'form-select form-select-sm w-auto',
                      id: 'wikipedia_sitelink_url',
                      data: {
                        sitelink_select_target: 'select',
                        action: 'change->sitelink-select#change'
                      } %>
                    <%= external_link_icon_to selected_wikipedia['url'],
                      data: { sitelink_select_target: 'link' } %>
                    <%= submit_tag 'add',
                      class: 'btn btn-sm btn-outline-primary',
                      disabled: @author_link_urls.include?(selected_wikipedia['url']),
                      data: { sitelink_select_target: 'submit' } %>
                  <% end %>
                <% end %>

                <% @other_sitelinks.each_with_index do |link, index| %>
                  <% external_resource = link['external_resource'] %>
                  <% url = link['url'] %>
                  <% existing_link = @author_links_by_url[url] %>
                  <%= form_with url: add_link_admin_wikidata_author_fetch_task_path(@task),
                    method: :post,
                    class: 'd-flex align-items-start justify-content-center gap-2 mb-2 b-task-link-form' do %>
                    <%= hidden_field_tag :url, url %>
                    <%= admin_reversible_input(old_value: existing_link&.external_resource) do %>
                      <%= text_field_tag :external_resource, external_resource,
                        class: 'form-control form-control-sm',
                        id: "external_resource_#{index}",
                        data: { input_changes_target: 'input' } %>
                    <% end %>
                    <%= external_link_icon_to url %>
                    <% if existing_link.nil? %>
                      <%= submit_tag 'add', class: 'btn btn-sm btn-outline-primary' %>
                    <% else %>
                      <%= submit_tag 'update label',
                        class: 'btn btn-sm btn-outline-primary',
                        disabled: existing_link.external_resource == external_resource,
                        data: { input_changes_submit: true } %>
                    <% end %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
<% end %>
