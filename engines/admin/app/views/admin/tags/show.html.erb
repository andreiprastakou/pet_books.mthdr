<% admin_nav_crumbs admin_nav_tags_link, admin_nav_tag_link(@tag) %>

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center">
    <div class="btn-group" role="group">
      <%= admin_buttonly_link_to "edit", edit_admin_tag_path(@tag) %>
      <%= display_link_to "display", tag_display_path(@tag) %>
    </div>

    <%= admin_actions_dropdown do %>
      <%= admin_dropdown_button_to "delete", admin_tag_path(@tag), method: :delete,
            class: "text-danger", data: { confirm: "Are you sure?" } %>
    <% end %>
  </div>
</div>

<div id="<%= dom_id @tag %>" class="container mt-4">
  <div class="row">
    <div class="container col-md-6">
      <div class="bg-light border p-3">
        <h5 class="mb-3">GENERAL</h5>

        <div class="row mb-3">
          <div class="col-md-3 font-weight-bold text-end">Name:</div>
          <div class="col-md-9"><%= @tag.name %></div>
        </div>

        <div class="row mb-3">
          <div class="col-md-3 font-weight-bold text-end">Category:</div>
          <div class="col-md-9"><%= @tag.category %></div>
        </div>

        <div class="row mb-3">
          <div class="col-md-3 font-weight-bold text-end">Created At:</div>
          <div class="col-md-9"><%= admin_timestamp(@tag.created_at) %></div>
        </div>

        <div class="row mb-3">
          <div class="col-md-3 font-weight-bold text-end">Updated At:</div>
          <div class="col-md-9"><%= admin_timestamp(@tag.updated_at) %></div>
        </div>
      </div>
    </div>
  </div>
</div>
