<%= turbo_frame_tag "wikipedia_updates_widget", target: "_top" do %>
  <div class="container mt-4">
    <h3>Wikipedia updates for review</h3>
    <table class="table b-external-updates-table">
      <thead>
        <tr>
          <th>
            Book fetches
            (<%= admin_link_to "#{@book_fetches_count} total",
                  admin_data_fetch_tasks_path(type: Admin::Tasks::WikipediaBookFetch.name, status: :fetched, commit: 'Filter') %>)
          </th>
          <th>
            Author fetches
            (<%= admin_link_to "#{@author_fetches_count} total",
                  admin_data_fetch_tasks_path(type: Admin::Tasks::WikipediaAuthorFetch.name, status: :fetched, commit: 'Filter') %>)
          </th>
        </tr>
      </thead>
      <tbody>
        <% row_count = [@book_fetches, @author_fetches].map(&:size).max %>
        <% if row_count.zero? %>
          <tr>
            <td colspan="2">No Wikipedia updates to review</td>
          </tr>
        <% else %>
          <% row_count.times do |i| %>
            <tr>
              <td>
                <% if (task = @book_fetches[i]) %>
                  <% title = "#{task.book.title} (#{task.book.year_published}) by #{task.book.author_names_label}" %>
                  <%= admin_link_to title, admin_data_fetch_task_path(task), title: title %>
                <% end %>
              </td>
              <td>
                <% if (task = @author_fetches[i]) %>
                  <%= admin_link_to task.author.fullname, admin_data_fetch_task_path(task) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
