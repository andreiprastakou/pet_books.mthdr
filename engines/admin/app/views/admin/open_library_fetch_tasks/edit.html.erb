<% book_ol_links = @book.external_identities.open_library.filter_map { |identity|
  url = Admin::ExternalLinkBuilders::OpenLibrary::Work.call(identity.external_id)
  url && external_link_to(identity.external_id, url)
} %>

<%= turbo_frame_tag "task_apply_form", target: "_top" do %>
  <div class="card mt-2">
    <div class="card-header">
      Open Library fetch results
    </div>

    <div class="card-body">
      <div class="mb-4">
        <div class="row mb-2">
          <div class="col-md-3 font-weight-bold text-end">Title:</div>
          <div class="col-md-9">
            <%= @book.title %><% if book_ol_links.any? %> (<%= safe_join(book_ol_links, ', ') %>)<% end %>
          </div>
        </div>

        <div class="row mb-2">
          <div class="col-md-3 font-weight-bold text-end">Year:</div>
          <div class="col-md-9"><%= @book.year_published %></div>
        </div>

        <div class="row mb-2">
          <div class="col-md-3 font-weight-bold text-end">Authors:</div>
          <div class="col-md-9">
            <% if @book.authors.empty? %>
              Unknown Author
            <% else %>
              <%= safe_join(@book.authors.map { |author|
                links = author.external_identities.open_library.filter_map { |identity|
                  url = Admin::ExternalLinkBuilders::OpenLibrary::Author.call(identity.external_id)
                  url && external_link_to(identity.external_id, url)
                }
                if links.any?
                  safe_join([author.fullname, ' (', safe_join(links, ', '), ')'])
                else
                  author.fullname
                end
              }, ', ') %>
            <% end %>
          </div>
        </div>

        <div class="row mb-2">
          <div class="col-md-3 font-weight-bold text-end">Current summary:</div>
          <div class="col-md-9">
            <% if @book.summary.present? %>
              <%= simple_format(@book.summary) %>
            <% else %>
              <span class="text-muted">None</span>
            <% end %>
          </div>
        </div>
      </div>

      <% if @fetched_data.blank? %>
        <p class="text-muted">No fetch results returned.</p>
      <% else %>
        <table class="table table-bordered align-top mb-0 b-task-fetch-results">
          <tbody>
            <tr>
              <td class="w-50">
                <pre class="mb-0 small b-task-fetch-data"><%= JSON.pretty_generate(@task.fetched_data_normalized) %></pre>
              </td>
              <td class="text-center">
                <% @identifiers.each do |external_resource, external_id| %>
                  <% link_builder = Admin::ExternalIdentityIntroductor.link_builder_for(external_resource, Book) %>
                  <% identity_url = link_builder&.call(external_id) %>
                  <% already_added = @book_identity_keys.include?([external_resource, external_id]) %>
                  <%= form_with url: add_identity_admin_open_library_fetch_task_path(@task),
                    method: :post,
                    class: "d-flex align-items-center justify-content-center gap-2 mb-2 flex-wrap",
                    data: { turbo: false } do %>
                    <%= hidden_field_tag :external_resource, external_resource %>
                    <%= hidden_field_tag :external_id, external_id %>
                    <span><%= external_resource %></span>
                    <% if identity_url.present? %>
                      <%= external_link_to external_id, identity_url %>
                    <% else %>
                      <%= external_id %>
                    <% end %>
                    <%= submit_tag "add to the book", class: "btn btn-sm btn-outline-primary",
                      disabled: already_added %>
                  <% end %>
                <% end %>

                <% if @description.present? %>
                  <%= form_with url: apply_summary_admin_open_library_fetch_task_path(@task),
                    method: :post,
                    class: "mt-3 text-start",
                    data: { turbo: false } do %>
                    <%= label_tag :summary, "Summary", class: "form-label" %>
                    <%= text_area_tag :summary, @description, class: "form-control mb-2", rows: 6 %>
                    <%= text_field_tag :summary_src, "Open Library", class: "form-control mb-2",
                      readonly: true %>
                    <%= submit_tag "apply summary", class: "btn btn-sm btn-outline-primary",
                      disabled: @description.blank? %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
<% end %>
