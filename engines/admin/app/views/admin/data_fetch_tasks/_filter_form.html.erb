<div class="container mt-4">
  <%= form_tag admin_data_fetch_tasks_path, method: :get do %>
    <div class="row">
      <div class="col-3">
        <%= select_tag :type,
                       options_for_select(
                         Admin::Tasks::BaseTask::TASK_TYPES.map { |type| [type.demodulize.underscore.humanize, type] },
                         params[:type]
                       ),
                       include_blank: 'All types',
                       class: 'form-select' %>
      </div>
      <div class="col-2">
        <%= select_tag :status,
                       options_for_select(
                         Admin::Tasks::BaseTask.statuses.keys.map { |status| [status.humanize, status] },
                         params[:status]
                       ),
                       include_blank: 'All statuses',
                       class: 'form-select' %>
      </div>
      <div class="col-2">
        <%= submit_tag 'Filter', class: 'btn btn-primary' %>
      </div>
    </div>
  <% end %>
</div>
