<% admin_nav_crumbs "Data Fetch Tasks" %>

<%= render "admin/data_fetch_tasks/filter_form" %>

<div class="container mt-4">
  <div>
    <%== @pagy.series_nav(:bootstrap) %>
  </div>
  <table class="table">
    <thead>
      <th>ID</th>
      <th>TYPE</th>
      <th>LINKS</th>
      <th>STATUS</th>
      <th>CREATED</th>
      <th>UPDATED</th>
    </thead>
    <% @tasks.each do |task| %>
      <tr>
        <td>
          <%= admin_link_to task.id, admin_data_fetch_task_path(task) %>
        </td>
        <td>
          <%= task.model_name.human %>
        </td>
        <td>
          <%= admin_link_to "show", admin_data_fetch_task_path(task) %>
        </td>
        <td>
          <%= task.status.humanize %>
        </td>
        <td>
          <%= admin_timestamp(task.created_at) %>
        </td>
        <td>
          <%= admin_timestamp(task.updated_at) %>
        </td>
      </tr>
    <% end %>
  </table>
  <div>
    <%== @pagy.series_nav(:bootstrap) %>
  </div>
</div>
