<%= render 'admin/data_fetch_tasks/task_info_card', task: task %>

<div class="card mt-2">
  <div class="card-header">Wikidata search results</div>
  <div class="card-body">
    <% data = task.fetched_data_normalized %>
    <% if data.blank? %>
      <p class="text-muted mb-0">No search results returned.</p>
    <% else %>
      <%= render 'admin/data_fetch_tasks/types/wikidata_data_table',
        rows: data %>
    <% end %>
  </div>
</div>
