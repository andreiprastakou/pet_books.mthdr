<%= render 'admin/data_fetch_tasks/task_info_card', task: task %>

<div class="card mt-2">
  <div class="card-header">Open Library author search results</div>
  <div class="card-body">
    <% usable_values = task.fetched_usable_values %>
    <% if usable_values.blank? %>
      <p class="text-muted mb-0">No search results returned.</p>
    <% else %>
      <% author_open_library_ids = task.author.external_identities.open_library.filter_map(&:external_id).to_set %>
      <table class="table table-bordered align-top mb-0 b-task-fetch-results">
        <tbody>
          <% usable_values.each do |result| %>
            <% result_data = result.is_a?(Hash) ? result : {} %>
            <% author_key = result_data['external_id'] %>
            <% author_olid = Admin::ExternalLinkBuilders::OpenLibrary::Author.normalize_id(author_key) %>
            <% author_url = author_olid && Admin::ExternalLinkBuilders::OpenLibrary::Author.call(author_olid) %>
            <% already_added = author_olid.present? && author_open_library_ids.include?(author_olid) %>
            <tr>
              <td class="w-50">
                <pre class="mb-0 small b-task-fetch-data"><%= JSON.pretty_generate(result) %></pre>
              </td>
              <td class="text-center">
                <% if author_olid.present? %>
                  <%= form_with url: add_author_identity_admin_open_library_author_search_task_path(task),
                    method: :post,
                    class: "d-flex align-items-center justify-content-center gap-2",
                    data: { turbo: false } do %>
                    <%= hidden_field_tag :author_key, author_olid %>
                    <% if author_url %>
                      <%= external_link_to author_olid, author_url %>
                    <% else %>
                      <%= author_olid %>
                    <% end %>
                    <%= submit_tag "add to the author", class: "btn btn-sm btn-outline-primary",
                      disabled: already_added %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
