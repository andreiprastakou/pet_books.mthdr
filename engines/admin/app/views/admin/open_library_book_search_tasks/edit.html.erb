<%= turbo_frame_tag "task_apply_form" do %>
  <div class="card mt-2">
    <div class="card-header">
      Open Library search results
    </div>

    <div class="card-body">
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if flash[:error].present? %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= flash[:error] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <% if @search_results.empty? %>
        <p class="text-muted">No search results returned.</p>
      <% else %>
        <table class="table table-bordered align-top mb-0 b-task-fetch-results">
          <tbody>
            <% @search_results.each_with_index do |result, index| %>
              <% result_data = result.is_a?(Hash) ? result : {} %>
              <% work_key = result_data['external_id'] %>
              <% work_olid = Admin::InfoFetchers::OpenLibrary::Api::BookDetailsFetcher.normalize_work_key(work_key) %>
              <% work_url = work_olid && Admin::ExternalLinkBuilders::OpenLibrary::Work.call(work_olid) %>
              <% work_already_added = work_olid.present? && @book_open_library_ids.include?(work_olid) %>
              <% author_keys = Array(result_data['authors']).filter_map { |author|
                author.is_a?(Hash) && author['external_id']
              } %>
              <tr>
                <td class="w-50">
                  <pre class="mb-0 small b-task-fetch-data"><%= JSON.pretty_generate(result) %></pre>
                </td>
                <td class="text-center">
                  <% if work_olid.present? %>
                    <%= form_with url: add_work_identity_admin_open_library_book_search_task_path(@task),
                      method: :post,
                      class: "d-flex align-items-center justify-content-center gap-2 mb-2" do %>
                      <%= hidden_field_tag :work_key, work_olid %>
                      <% if work_url %>
                        <%= external_link_to work_olid, work_url %>
                      <% else %>
                        <%= work_olid %>
                      <% end %>
                      <%= submit_tag "add to the book", class: "btn btn-sm btn-outline-primary",
                        disabled: work_already_added %>
                    <% end %>
                  <% end %>

                  <% author_keys.each_with_index do |author_key, author_index| %>
                    <% author_olid = Admin::ExternalLinkBuilders::OpenLibrary::Author.normalize_id(author_key) %>
                    <% next if author_olid.blank? %>
                    <% author_url = Admin::ExternalLinkBuilders::OpenLibrary::Author.call(author_olid) %>
                    <% existing_identity = @author_identities_by_olid[author_olid] %>
                    <% existing_author = existing_identity&.owner %>
                    <% already_assigned = existing_author.present? %>
                    <% author_on_book = existing_author && @book.author_ids.include?(existing_author.id) %>
                    <% select_authors = @book.authors.to_a %>
                    <% select_authors = (select_authors + [existing_author]).uniq if existing_author && !author_on_book %>
                    <div class="mb-2">
                      <%= form_with url: add_author_identity_admin_open_library_book_search_task_path(@task),
                        method: :post,
                        class: "d-flex align-items-center justify-content-center gap-2 flex-wrap" do %>                        <%= hidden_field_tag :author_key, author_olid %>
                        <% if author_url %>
                          <%= external_link_to author_olid, author_url %>
                        <% else %>
                          <%= author_olid %>
                        <% end %>
                        <%= select_tag :author_id,
                          options_from_collection_for_select(select_authors, :id, :fullname, existing_author&.id),
                          class: "form-select form-select-sm w-auto",
                          id: "author_id_#{index}_#{author_index}",
                          disabled: already_assigned || select_authors.empty? %>
                        <%= submit_tag "add to the author", class: "btn btn-sm btn-outline-primary",
                          disabled: already_assigned || select_authors.empty? %>
                      <% end %>
                      <% if existing_author && !author_on_book %>
                        <div class="text-danger small mt-1">
                          Author "<%= existing_author.fullname %>" is not linked to this book.
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
<% end %>
