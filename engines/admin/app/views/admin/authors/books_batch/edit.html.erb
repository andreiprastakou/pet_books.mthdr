<% admin_nav_crumbs admin_nav_authors_link, admin_nav_author_link(@author), "Books Batch Edit" %>

<div class="card">
  <div class="card-header">
    Authors:
  </div>

  <div class="card-body">
    <div class="row mb-3">
      <div class="col-md-3 font-weight-bold text-end"><%= @author.fullname %></div>
      <div class="col-md-9"><%= admin_external_links_list(@author) %></div>
    </div>
  </div>
</div>

<div class="card mt-2">
  <div class="card-header">
    Books to update:
  </div>

  <div class="card-body">
    <%= render 'admin/books/batch_edit',
      books: @books,
      target: admin_author_books_batch_path(@author),
      initial_authors: [@author] %>
  </div>
</div>
