<%= form_with(model: [:admin, @author, @external_identity], class: "needs-validation", novalidate: true) do |form| %>
  <%= render "admin/common/form_errors", form_record: @external_identity %>

  <div class="mb-3">
    <%= form.label :external_resource, class: "form-label" %>
    <%= form.select :external_resource,
      ExternalIdentity.external_resources.keys.map { |r| [r.titleize, r] },
      { include_blank: true },
      class: "form-select", required: true %>
    <div class="invalid-feedback">
      Please select an external resource.
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :external_id, "External ID", class: "form-label" %>
    <%= form.text_field :external_id, class: "form-control", required: true %>
    <div class="invalid-feedback">
      Please provide an external ID.
    </div>
  </div>

  <div class="mb-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_author_path(@author), class: "btn btn-secondary" %>
  </div>
<% end %>

<%= render "admin/common/bootstrap_form_validator" %>
