<!DOCTYPE html>
<html>
  <head>
    <title>Books.mthdr Admin <%= Rails.env.production? ? '' : " (#{Rails.env})" %> > <%= yield :page_title %></title>
    <%= favicon_link_tag asset_path('bookshelf-icon.png') %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-prefetch" content="false">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>
    <%= javascript_pack_tag "admin", "data-turbo-track": "reload", defer: true %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark b-admin-navbar">
      <div class="container">
        <div class="b-admin-navbar-home">
          <%= link_to main_app.root_path, class: "navbar-brand b-admin-navbar-icon" do %>
            <%= image_tag "bookshelf-icon.png", alt: "Home", height: 24, width: 24 %>
          <% end %>
          <span class="b-admin-navbar-separator" aria-hidden="true">&gt;</span>
          <%= link_to "ADMIN", admin_root_path, class: "navbar-brand" %>
        </div>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav b-admin-navbar-links">
            <li class="nav-item">
              <%= link_to "Books", admin_books_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Authors", admin_authors_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Tags", admin_tags_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Genres", admin_genres_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Series", admin_series_index_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Collections", admin_collections_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Public Lists", admin_public_list_types_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Cover Designs", admin_covers_cover_designs_path, class: "nav-link" %>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                Tasks
              </a>
              <ul class="dropdown-menu dropdown-menu-dark">
                <li>
                  <%= link_to "AI Chats", admin_ai_chats_path, class: "dropdown-item" %>
                </li>
                <li>
                  <%= link_to "Data Fetch Tasks", admin_data_fetch_tasks_path, class: "dropdown-item" %>
                </li>
                <li>
                  <%= link_to "Mission Control", admin_mission_control_jobs_path, class: "dropdown-item", target: "_blank" %>
                </li>
              </ul>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <h1><%= yield :title %></h1>

      <%= yield %>
    </div>
  </body>
</html>
