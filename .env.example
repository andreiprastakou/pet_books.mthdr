ADMIN_USERNAME=ADMIN
ADMIN_PASSWORD=PASSWORD

AWS_ACCESS_KEY_ID=AWS_KEY_ID
AWS_SECRET_ACCESS_KEY=AWS_SECRET

OPENAI_API_KEY=KEY

# Optional identifying User-Agent (falls back to OPEN_LIBRARY_USER_AGENT).
# OPEN_LIBRARY_USER_AGENT='books.mthdr (you@example.com)'
# WIKIDATA_USER_AGENT='books.mthdr (you@example.com)'
# WIKIPEDIA_USER_AGENT='books.mthdr (you@example.com)'

# Free LibraryThing developer token from https://www.librarything.com/developer
LIBRARYTHING_APP_TOKEN=TOKEN

FLY_API_TOKEN="FLY_TOKEN"

# COVERAGE=true

# Webpack dev server port (default: 3035, used by shakapacker)
# SHAKAPACKER_DEV_SERVER_PORT=3035
